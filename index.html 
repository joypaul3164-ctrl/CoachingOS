async function initCloud(){if(!configured())return false;if(!window.supabase){toast("Supabase library load হয়নি। ইন্টারনেট সংযোগ চালু করে পেজ Reload করুন।");return false}try{sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);cloud=true;$("connectionState").textContent="CLOUD";return true}catch(e){toast("Supabase init error: "+e.message);return false}}
async function signUp(){try{let email=$("email").value.trim(),password=$("password").value;if(!email||!/^\S+@\S+\.\S+$/.test(email)){toast("সঠিক Email address লিখুন");return}if(password.length<6){toast("Password কমপক্ষে ৬ অক্ষরের হতে হবে");return}if(!configured()){toast("Supabase Project URL ও Publishable Key ঠিক করুন");return}if(!sb&&!(await initCloud()))return;if(!sb)return toast("Supabase সংযোগ হয়নি। ইন্টারনেট পরীক্ষা করে Reload করুন।");$("signupBtn").disabled=true;let r=await sb.auth.signUp({email,password});if(r.error){toast("Sign up failed: "+r.error.message);return}if(!r.data.session){toast("Account তৈরি হয়েছে। আপনার Email Inbox/Spam থেকে verification link-এ চাপুন, তারপর Sign In করুন।");return}user=r.data.user;await afterAuth();}catch(e){toast("Create Admin error: "+(e.message||e))}finally{$("signupBtn").disabled=false}}
async function signIn(){try{let email=$("email").value.trim(),password=$("password").value;if(!email||!password){toast("Email ও Password দিন");return}if(!configured()){toast("Supabase Project URL ও Publishable Key বসানো হয়নি");return}if(!sb&&!(await initCloud()))return;if(!sb)return toast("Supabase সংযোগ হয়নি। ইন্টারনেট পরীক্ষা করে Reload করুন।");$("loginBtn").disabled=true;let r=await sb.auth.signInWithPassword({email,password});if(r.error){toast("Sign in failed: "+r.error.message);return}user=r.data.user;await afterAuth()}catch(e){toast("Login error: "+(e.message||e))}finally{$("loginBtn").disabled=false}}
async function signOut(){if(sb&&cloud)await sb.auth.signOut();user=null;activeInstitute=""