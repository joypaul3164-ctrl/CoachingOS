function miniTable(module,fields){let list=(rows[module]||[]).slice(0,5);if(!list.length)return `<div class="empty">${t("এখনো কোনো তথ্য নেই","No records yet")}</div>`;return `<div class="table-wrap"><table><thead><tr>${fields.map(f=>`<th>${esc(fieldLabel(module,f))}</th>`).join("")}</tr></thead><tbody>${list.map(x=>`<tr>${fields.map(f=>`<td>${esc(x[f]||"—")}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`}
function fieldLabel(m,key){let f=modules[m].fields.find(x=>x[0]===key);return f?(lang==="bn"?f[1]:f[2]):key}
function renderModule(m){let mod=modules[m];if(!mod)return;$("content").innerHTML=`<div class="welcome"><div><h1>${lang==="bn"?mod.title:mod.en}</h1><div class="muted">${t("তথ্য যোগ, সম্পাদনা ও ব্যবস্থাপনা করুন","Add, edit and manage records")}</div></div><button class="btn" onclick="openForm('${m}')" ${canWrite(m)?"":"disabled"}>＋ ${t("নতুন যোগ করুন","Add new")}</button></div><div class="panel"><div class="toolbar"><input class="search" id="tableSearch" placeholder="${t("নাম বা তথ্য দিয়ে খুঁজুন...","Search records...")}" oninput="filterTable('${m}')"><button class="btn secondary small" onclick="exportModule('${m}')">↓ CSV</button></div><div id="tableArea">${moduleTable(m,rows[m])}</div></div>`}
function moduleTable(m,list){let mod=modules[m],fields=mod.fields; if(!list.length)return `<div class="empty">${t("কোনো তথ্য পাওয়া যায়নি। নতুন তথ্য যোগ করুন।","No records found. Add a new record.")}</div>`;return `<div class="table-wrap"><table><thead><tr>${fields.map(f=>`<th>${esc(lang==="bn"?f[1]:f[2])}</th>`).join("")}<th>${t("কাজ","Actions")}</th></tr></thead><tbody>${list.map(x=>`<tr>${fields.map(f=>`<td>${f[0]==="status"?statusTag(x[f[0]]):esc(x[f[0]]||"—")}</td>`).join("")}<td><div style="display:flex;gap:5px"><button class="btn secondary small" onclick="openForm('${m}','${x.id}')">✎</button><button class="btn danger small" onclick="deleteRecord('${m}','${x.id}')">×</button></div></td></tr>`).join("")}</tbody></table></div>`}
function statusTag(v){let c=["Active","Present","Paid","Completed"].includes(v)?"green":["Absent","Inactive","Disabled"].includes(v)?"red":"amber";return `<span class="tag ${c}">${esc(v||"—")}</span>`}
function filterTable(m){let q=$("tableSearch").value.toLowerCase();let list=rows[m].filter(x=>Object.values(x).some(v=>String(v??"").toLowerCase().includes(q)));$("tableArea").innerHTML=moduleTable(m,list)}
function openForm(m,id){if(!canWrite(m))return toast("আপনার permission নেই");let mod=modules[m],item=id?rows[m].find(x=>x.id===id)||{}:{};editingId=id||null;let fields=mod.fields.map(f=>{let [key,bn,en,type,required,opts]=f,label=lang==="bn"?bn:en,val=item[key]??"";let control=type==="select"?`<select id="f_${key}">${(opts||[]).map(o=>`<option ${o===val?"selected":""}>${esc(o)}</option>`).join("")}</select>`:type==="textarea"?`<textarea id="f_${key}">${esc(val)}</textarea>`:`<input id="f_${key}" type="${type}" value="${esc(val)}" ${required?"required":""}>`;return `<div class="field"><label>${esc(label)} ${required?"*":""}</label>${control}</div>`}).join("");$("modalRoot").innerHTML=`<div class="modal-back" onclick="if(event.target===this)closeModal()"><div class="modal"><h3>${id?t("তথ্য সম্পাদনা","Edit record"):t("নতুন তথ্য যোগ","Add new record")} · ${lang==="bn"?mod.title:mod.en}</h3><form onsubmit="submitForm(event,'${m}')"><div class="form-grid">${fields}</div><div class="form-actions"><button type="button" class="btn ghost" onclick="closeModal()">${t("বাতিল","Cancel")}</button><button class="btn" type="submit">${t("সংরক্ষণ","Save")}</button></div></form></div></div>`}
function closeModal(){$("modalRoot").innerHTML="";editingId=null}
async function submitForm(e,m){e.preventDefault();let data={};for(let f of modules[m].fields){let el=$("f_"+f[0]);data[f[0]]=el?el.value.trim():""}if(m==="fees"){let a=Number(data.amount)||0,p=Number(data.paid)||0;data.due=Math.max(0,a-p).toString()}let ok=await saveRecord(m,data,editingId);if(ok&&m==="users"&&cloud&&data.user_id){toast("স্টাফের তথ্য")}
